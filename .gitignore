# Upstream whisper.cpp clone (build it yourself via setup.sh) - never vendor this,
# it's a full separate project with its own multi-GB build artifacts and model weights.
whisper.cpp/

# Real test videos and their generated per-video output folders
# (subtranslate.py writes outputs into a <video-stem>/ folder next to the input video,
# e.g. test_jp2/ containing test_jp2.ja.srt, test_jp2.ja.llm_vision.md, etc. - those
# logs embed base64 JPEG frames extracted straight from the source video, so this needs
# to catch the whole output folder, not just specific file types.)
test_*.mp4
test_*/

# subtranslate.py's generated outputs, wherever they end up
*.wav
*.srt
*.output.mkv
*.vad_trimmed.wav
*.llm_repeats.md
*.llm_context_primer.md
*.llm_rationality.md
*.llm_vision.md
*.llm_raw.md

# Python / editor cruft
__pycache__/
*.pyc
.claude/settings.local.json
.vscode/
